# NO FILTER — capture configuration
#
# Copy to .env.local and fill in what you need. Everything here is server-only;
# nothing is exposed to the browser. .env.local is gitignored — never commit
# real credentials.

# ---------------------------------------------------------------------------
# Where signups go
# ---------------------------------------------------------------------------
# Leave the Google block empty and rows append to a local CSV instead. The
# store picks itself: Sheets when all three are set, CSV otherwise.

# Path for the CSV fallback. Anywhere you can write — your Desktop is fine.
# Defaults to ./data/signups.csv
# CAPTURE_CSV_PATH="/Users/you/Desktop/nofilter-signups.csv"

# The CSV is refused in production, because serverless filesystems are wiped on
# every redeploy and rows would vanish silently. Only set this if you are
# genuinely running on a box with a persistent disk.
# CAPTURE_ALLOW_CSV=false

# ---------------------------------------------------------------------------
# Google Sheets (for anything deployed)
# ---------------------------------------------------------------------------
# Create a service account, enable the Google Sheets API, then share the
# spreadsheet with the service account's email address as an Editor. A valid
# key on an unshared sheet is the usual cause of a 403.

# The long id out of the sheet URL, between /d/ and /edit
# GOOGLE_SHEETS_ID=

# something@your-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The full PEM block in quotes. Literal \n escapes are handled.
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Tab name within the spreadsheet. Defaults to Signups.
# GOOGLE_SHEETS_TAB=Signups

# ---------------------------------------------------------------------------
# Consent evidence
# ---------------------------------------------------------------------------
# Salt for the stored IP hash. Without it the column reads "unsalted" and the
# rows lose their proof-of-origin, so set this to any long random string before
# collecting anything you intend to message later. Changing it later makes old
# and new rows incomparable — pick one and keep it.
# CAPTURE_HASH_SALT=
